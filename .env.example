# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=ncpor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ncpor
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://ncpor:change-me@localhost:5433/ncpor

# --- Language model (Google Gemini) ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Check current model names at https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=your-gemini-model-name-here

# --- Embeddings (runs locally, no key needed) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- OCR ---
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Staff login ---
# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Harvester ---
HARVEST_USER_AGENT=NCPOR-Polar-Index-SIH-Prototype/0.1 (student project; contact: your-email@example.com)
HARVEST_MIN_INTERVAL_SECONDS=1.0
